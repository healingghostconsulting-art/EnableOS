# EnableOS — environment variables (example). Copy to .env and fill in locally.
# NEVER commit real secret values. This file documents keys only.

# ── Core app / auth ───────────────────────────────────────────────────────────
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
# MySQL connection string. Optional locally — the app degrades to in-memory when unset.
DATABASE_URL=
# HTTP port (defaults to 3000, auto-scans upward if busy).
PORT=3000

# ── Managed platform (Forge/Manus) — pre-injected by the host in production ────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Notification delivery (DELIVER2) ──────────────────────────────────────────
# Public origin used to build deep links inside notification emails, e.g.
# https://app.example.com  (no trailing slash). Empty → links are relative.
APP_PUBLIC_URL=
# Amazon SES sending config. Leave blank to keep email delivery stubbed.
SES_REGION=
SES_FROM_ADDRESS=
SES_FROM_NAME=
# Hard safety gate. Must be exactly "true" AND all SES_* set for any real send.
# Anything else keeps every provider in no-op/stub mode.
ALLOW_REAL_SEND=false

# ── Digest (DELIVER4) ─────────────────────────────────────────────────────────
# Opens the guarded manual trigger for POST /api/scheduled/digest?manual=1 so a
# dev/admin can fire the digest without waiting for the managed Heartbeat cron.
# Default false — production digests only fire from the authenticated cron.
ALLOW_MANUAL_DIGEST=false

# ── Demo mode (Phase 1 hardening) ─────────────────────────────────────────────
# Gates the unauthenticated public "mirror" procedures that back the demo
# (dashboards + preview writers + notification outbox/prefs). Default true.
# Set DEMO_MODE=false in PRODUCTION to 404 those endpoints and force all tenant
# data through the authenticated, server-scoped secure* procedures.
DEMO_MODE=true
