# ─────────────────────────────────────────────────────────────────────────────
# EnableOS — environment variables
#
# Copy to `.env` and fill in real values (`.env` is gitignored; this file is not).
# Every variable the app actually reads is listed. VITE_* are build-time and PUBLIC
# (bundled into the client — never put secrets there). Everything else is server-side.
# Values here are placeholders/examples only — no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core runtime ─────────────────────────────────────────────────────────────
# "production" enables HSTS + CSP and serves the built static app; set by the host.
NODE_ENV=production
# HTTP port the server listens on (auto-increments if busy). Default 3000.
PORT=3000
# false = PRODUCTION: forces all tenant data through authenticated secure* procedures
# AND enables real MySQL persistence (shouldPersist). true = the shared demo (optimistic,
# non-persisting, reset-friendly). Default true when unset.
DEMO_MODE=false
# Public origin of the deployed app; used to build deep links in notification emails.
APP_PUBLIC_URL=https://your-app.example.com

# ── Database (Drizzle / MySQL) ───────────────────────────────────────────────
# MySQL connection string. From your DB provider (PlanetScale/RDS/etc.). Required in
# prod; used by the server at runtime and by `pnpm db:push` to apply migrations.
DATABASE_URL=mysql://user:password@host:3306/enableos

# ── Auth: session signing (all providers) ────────────────────────────────────
# Secret used to sign/verify the session cookie (JWT, HS256). Generate a long random
# string (e.g. `openssl rand -hex 32`). Keep server-side only.
JWT_SECRET=replace-with-a-long-random-string

# ── Auth: provider selector (server/_core/authProvider.ts) ───────────────────
# Which auth backend to use: "manus" (default, the demo OAuth) or "clerk" (managed IdP).
# Switching is env-only — no call sites change.
AUTH_PROVIDER=manus

# ── Auth: Manus OAuth (default provider) ─────────────────────────────────────
# Base URL of the Manus OAuth server (token exchange + user info). From Manus.
OAUTH_SERVER_URL=https://oauth.manus.example.com
# Manus application id. Rejects session tokens minted for a different app. PUBLIC
# (client build-time). From the Manus app dashboard.
VITE_APP_ID=your-manus-app-id
# OAuth portal URL the client redirects to for sign-in. PUBLIC. From Manus.
VITE_OAUTH_PORTAL_URL=https://portal.manus.example.com
# openId of the account auto-promoted to the "admin" app role on login (bootstrap owner).
# From your own Manus account's openId.
OWNER_OPEN_ID=

# ── Auth: Clerk (managed IdP seam — only when AUTH_PROVIDER=clerk) ────────────
# Not read until the ClerkAuthProvider is implemented; documented here as the drop-in.
# Clerk backend secret key for server-side session verification. From the Clerk dashboard.
CLERK_SECRET_KEY=
# Clerk PEM public key for networkless JWT verification (optional, perf). From Clerk.
CLERK_JWT_KEY=
# Clerk frontend publishable key. PUBLIC (client build-time). From the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=

# ── Hardening (server/_core/hardening.ts) ────────────────────────────────────
# "true" enforces the Content-Security-Policy; unset/false ships it Report-Only (safe
# default — never blocks). Flip to true once validated against the live build.
CSP_ENFORCE=false
# Per-IP request cap per minute on /api/trpc (429 past the cap). Default 300.
RATE_LIMIT_PER_MIN=300

# ── Object storage (Manus Forge presign → S3) ───────────────────────────────
# The app uploads via the Manus Forge presigned-URL flow (server/storage.ts), not with
# direct bucket credentials. Base URL of the Forge API. From Manus.
BUILT_IN_FORGE_API_URL=https://forge.manus.example.com
# Forge API key (server secret). From Manus.
BUILT_IN_FORGE_API_KEY=
# Forge API base + key for client-side calls. PUBLIC (client build-time — the key is
# exposed in the bundle; scope it accordingly). From Manus.
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.example.com
VITE_FRONTEND_FORGE_API_KEY=

# ── Object storage: direct S3 / Cloudflare R2 (opt-in) ────────────────────────
# Provider selector for server/storage.ts: "forge" (default) or "s3". The S3/R2 adapter
# activates ONLY when this is "s3" AND all the S3_* keys below are set; otherwise it
# falls back to Forge, so the demo/current deploy are unaffected.
STORAGE_PROVIDER=forge
# S3/R2 connection. Set S3_ENDPOINT for R2/MinIO (the S3 API at a custom endpoint) and
# omit it for AWS S3. S3_REGION defaults to "auto" (R2). From AWS/Cloudflare.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email delivery (AWS SES — notifications) ─────────────────────────────────
# Master switch: "true" actually sends email; anything else uses the stub (no send).
# Default off, so nothing sends without an explicit, credentialed opt-in.
ALLOW_REAL_SEND=false
# AWS region for SES. From AWS.
SES_REGION=us-east-1
# Verified "From" address for outbound notifications. From AWS SES.
SES_FROM_ADDRESS=notifications@your-domain.example.com
# Display name on the "From" header.
SES_FROM_NAME=EnableOS
# NOTE: AWS SES credentials themselves come from the standard AWS SDK chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / instance role) — set per your host.

# ── Scheduled digest (DELIVER4) ──────────────────────────────────────────────
# "true" opens the guarded manual trigger at POST /api/scheduled/digest for dev/admin
# verification. Default false — production digests fire only from the Heartbeat cron.
ALLOW_MANUAL_DIGEST=false
